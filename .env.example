# PostgreSQL connection string used by Prisma at runtime (pooled).
DATABASE_URL=

# Direct PostgreSQL URL used by Prisma migrations (bypasses pooler).
DIRECT_URL=

# Secret used to sign JWTs. Generate a long random string for production.
JWT_SECRET=

# HTTP port (default 5000).
PORT=5000

# Supabase project URL and service-role key, used for profile-picture storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
