  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@supabase/supabase-js": "^2.105.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.4",
    "prisma": "^6.19.2",
    "zod": "^4.3.6"
  },
